# ============================================
# Sorterra Docker Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Environment
ASPNETCORE_ENVIRONMENT=Development

# MySQL Database
MYSQL_ROOT_PASSWORD=localdev
MYSQL_DATABASE=sorterra_dev
MYSQL_USER=sorterra
MYSQL_PASSWORD=sorterra_pass

# Amazon Cognito
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your_app_client_id

# Microsoft Graph API
GRAPH_TENANT_ID=your_azure_tenant_id
GRAPH_CLIENT_ID=your_azure_app_client_id
GRAPH_CLIENT_SECRET=your_azure_app_secret

# Encryption (CHANGE IN PRODUCTION!)
TOKEN_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!
